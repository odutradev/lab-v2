# Server Configuration
PORT=5000
NODE_ENV=development
# Domínios permitidos para CORS separados por vírgula (ou * para todos)
CORS_ORIGIN=https://lab.odutra.com,http://localhost:3000

# MongoDB Connection String
MONGOURI=mongodb://localhost:27017/lab-v2
MONGOURI_TEST=mongodb://localhost:27017/lab-v2-test

# Security & Secrets
JWT=your_super_secret_jwt_key_here
JWT_SECRET=your_super_secret_jwt_key_here
PRODUCTION=false

# Mailer
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=user@example.com
EMAIL_PASS=your_email_password
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=user@example.com

# Frontend Configuration
FRONTEND_PORT=3000
# URL da API acessível pelo cliente/navegador em produção (ex: https://api.seudominio.com)
VITE_API_URL=http://localhost:5000

